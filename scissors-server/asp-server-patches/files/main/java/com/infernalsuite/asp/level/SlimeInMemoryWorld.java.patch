+    private void putVanillaData(String kind, int x, int z, net.minecraft.nbt.CompoundTag tag) {
+        String key = "scissors:vanilla/" + kind + "/" + x + "/" + z;
+        if (tag == null) {
+            this.extra.remove(key);
+        } else {
+            this.extra.put(key, Converter.convertTag(tag));
+        }
